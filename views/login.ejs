<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
<%- include('./partials/head.ejs') %>
</head>

<body>
	<!-- Header --> 
	<% if (locals.user != undefined) { %>
		<%- include('./partials/headerLogueado') %>
	<% } else { %>
		<%- include('./partials/header') %>
	<% } %>
	<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Ingresar</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<h2 class="col-12"> 
				<form action="/users/login" method="POST">
					<label class="form">Email:</label>
					<input type="email" name="email" id="email" class="form-input" required>


					<label class="form">Contraseña:</label>
					<input type="password" name="contrasenia" id="contrasenia" class="form-input" required>

					<input type="checkbox" id="tyc" name="recordarme">
					<label for="tyc" class="form">Recordame</label>

					<button type="submit" class="btn">Ingresar</button>
				</form>


	<!-- footer -->
	<footer class="main-footer"> 
 <%- include('partials/footer') %>
  </footer>
	<!-- /footer -->
</body>

</html>