<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
	<%- include('partials/head') %>
</head>

<body>
	<!-- Header -->
	<% if (locals.user !=undefined) { %>
		<%- include('./partials/headerLogueado') %>
			<% } else { %>
				<%- include('./partials/header') %>
					<% } %>
						<!-- /Header -->

						<!-- Datos del usuario -->
						<section class="info-usuario container products-wrapper">
							<div class="row">
								<div class="img-container offset-3 col-2">
									<img src="<%= usuario.avatar %>" alt="Foto de perfil de <%= usuario.nombre %>"
										class="foto-perfil">
								</div>
								<div class="data-container col-6">
									<div class="d-flex align-items-center ">
										<h1 class="main-title">
											<%= usuario.nombre %>
												<% if (locals.user && locals.user.id==usuario.id) { %>
													<a href="/users/profile-edit/<%= usuario.id %>">
														<i class="fas fa-cog"></i>
													</a>
													<% } %>
										</h1>
										<a class="btn mt-3 ml-4" href="">SEGUIR</a>
									</div>
									<div>
										<ul class="infousuario">
											<li>
												<%= usuario.email %>
											</li>
											<li>
												<%= allproducts.length %> productos
											</li>
											<li>0 seguidores</li>
											<li>
												<%= usuario.comments.length %> comentarios
											</li>
										</ul>
									</div>
								</div>
							</div>
						</section>
						<!-- /Datos del usuario -->

						<!-- Mis productos -->
						<div class="container products-wrapper">
							<div class="row">
								<div class="col-12">
									<h2 class="products-title">Mis productos</h2>
								</div>
								<!-- Show mis productos -->
								<div class="row">
									<% if (allproducts && allproducts.length> 0) { %>
										<% for (let i=0; i < allproducts.length; i++) { let producto=allproducts[i]; %>
											<div class="col-12 col-sm-6 col-lg-3">
												<section class="product-box">
													<a href="/product/<%= producto.id %>">
														<figure class="product-box_image">
															<img src="<%= producto.imagen %>"
																alt="<%= producto.nombre %>">
														</figure>
														<article class="product-box_data">
															<h2>
																<%= producto.nombre %>
															</h2>
															<p>
																<%= producto.descripcion %>
															</p>
															<p>Comentarios: <%= producto.comments.length %>
															</p>
														</article>
													</a>
												</section>
											</div>
											<% } %>
												<% } else { %>
													<div class="col-12">
														<p>Este usuario aún no ha publicado productos.</p>
													</div>
													<% } %>
								</div>

								<!-- /Mis productos -->


								<!-- footer -->
								<footer class="main-footer">
									<%- include('partials/footer') %>
								</footer>
								<!-- /footer -->
</body>

</html>