<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<head>
<%- include('./partials/head.ejs') %>
</head>
<body>
	<!-- Header -->
	<% if (locals.user != undefined) { %>
		<%- include('./partials/headerLogueado') %>
	<% } else { %>
		<%- include('./partials/header') %>
	<% } %>
	<!-- /Header -->
	
	<!-- product detail -->
	<div class="container products-wrapper">
		<div class="d-flex align-items-center">
			<h2 class="products-title"><%= producto.nombre %></h2>
			<p class="product-detail-description">
				<a href="/product-add">Editar</a>
			</p>
		</div>
		<div class="product-detail">
			<div class="row">
				<article class="col-12 col-lg-8 product-detail-info">
					<img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" class="product-detail-img">
					<p class="product-detail-description">
						<%= producto.descripcion %>
					</p>
				</article>
				<div class="col-12 col-lg-4">
					<section class="comments">
						<% for (let i = 0; i < producto.Comment.length; i++) { 
                            let comentario = producto.Comment[i]; %>
                        <article>
                            <img src="<%= comentario.User.avatar %>" alt="Avatar de <%= comentario.User.nombre %>">
                            <div class="data">
                                <p class="user">
                                    <strong> <a href="/users/profile/<%= comentario.User.id %>"><%= comentario.User.nombre %> </a> </strong>
                                    <%= comentario.comentario %>
                                </p>
                            </div>
                        </article>
                        <% } %>
					</section>
					<form class="form" action="" method="GET">
						<input class="form-input" type="text" value="" placeholder="Agregar comentario">
						<button type="submit" class="buy-now-button">AGREGAR COMENTARIO</button>
					</form>
					<hr>
				</div>
			</div>
		</div>
	</div>
	<!-- /product detail -->

	<!-- footer -->
	<footer class="main-footer"> 
 <%- include('partials/footer') %>
  </footer>
	<!-- /footer -->

</body>	
</html>